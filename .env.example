# -------------------------------------------------------
# ReagentSearch Environment Variables
# -------------------------------------------------------
# Copy this file to .env.local for local development.
# In Netlify, set these under Site Settings > Environment Variables.

# --- Firebase (Optional) ---
# Enables result caching (4-hour TTL) so repeated searches are instant.
# Without this, the app still works but scrapes fresh on every search.
#
# Steps:
#   1. Go to Firebase Console -> Project Settings -> Service Accounts
#   2. Generate new private key (downloads a JSON file)
#   3. Paste the ENTIRE JSON file as a single line (minified) below
#
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
